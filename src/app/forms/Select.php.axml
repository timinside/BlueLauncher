      <elementSetText object="labelAlt" object-type="object" relative="" relative-type="" value="Начинаем скачивание..." value-type="string"/>
      <sleep sync="" sync-type="" value="200" value-type="integer"/>
      <open file="urlDownload" file-type="globalVariable"/>
