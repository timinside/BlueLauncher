<class name="Select">
    
  
  
  
  
  <method name="doClose">
      <setVar name="productName" name-type="" value="no" value-type="string"/>
    </method>
  
  
  
  
    
  <method name="doButton6ClickLeft">
      <setVar name="productName" name-type="" value="BetterDevelNext" value-type="string"/>
      <hideForm form="Select" form-type="form"/>
    </method>
  
  
    
  
  
  
  
  <method name="doButtonAltClickLeft">
      <setVar name="productName" name-type="" value="XTweaker" value-type="string"/>
      <hideForm form="Select" form-type="form"/>
    </method>
  <method name="doButton9ClickLeft">
