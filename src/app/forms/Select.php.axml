      <elementHide object="progressBar" object-type="object"/>
      <elementShow object="button" object-type="object"/>
      <exit/>
      <closeBlock/>
      <ifVar method="contains" method-type="" name="productName" name-type="" not="" not-type="" value="LunaOS10" value-type="string"/>
      <openBlock/>
      <phpLine expr="file_put_contents('C:/Windows/Temp/BlueLauncher/install.log', &quot;[INFO] Продукт для скачивания: LunaOS 10\r\n&quot;, FILE_APPEND)" expr-type="expr"/>
      <elementSetText object="label" object-type="object" relative="" relative-type="" value="Скачивание LunaOS 10" value-type="string"/>
      <phpLine expr="file_put_contents('C:/Windows/Temp/BlueLauncher/install.log', &quot;[INFO] Получение ссылок...\r\n&quot;, FILE_APPEND)" expr-type="expr"/>
      <elementSetText object="labelAlt" object-type="object" relative="" relative-type="" value="Получение ссылок..." value-type="string"/>
      <setProperty object="progressBar" object-type="object" property="progress" property-type="" value="5" value-type="string"/>
      <sleep sync="" sync-type="" value="200" value-type="integer"/>
      <setVar name="urlDownload" name-type="" value="file_get_contents('https://raw.githubusercontent.com/timinside/LunaOS/refs/heads/main/url/lunaos10.ini')" value-type="expr"/>
      <ifVar method="contains" method-type="" name="$urlDownload" name-type="" not="" not-type="" value="none" value-type="string"/>
      <openBlock/>
      <phpLine expr="file_put_contents('C:/Windows/Temp/BlueLauncher/install.log', &quot;[ERROR] Установка отменена: ссылка для скачивания не задана.\r\n&quot;, FILE_APPEND)" expr-type="expr"/>
      <elementSetText object="label" object-type="object" relative="" relative-type="" value="Скачивание отменено" value-type="string"/>
      <elementSetText object="labelAlt" object-type="object" relative="" relative-type="" value="Ссылка для скачивания не задана." value-type="string"/>
